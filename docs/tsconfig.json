{
  // For editors and `pnpm typecheck`; the VitePress build doesn't read it.
  // Also stops TypeScript's upward search for a tsconfig at this folder.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": []
  },
  "include": [".vitepress/**/*.ts", ".vitepress/**/*.mts", ".vitepress/**/*.vue", ".vitepress/**/*.d.ts"],
  "exclude": [".vitepress/cache", ".vitepress/dist"]
}
